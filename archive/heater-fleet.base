filters:
  and:
    - note.type == "heater"
properties:
  note.heater-tag:
    displayName: Heater
  note.heater-type:
    displayName: Type
  note.service:
    displayName: Service
  note.facility:
    displayName: Facility
  note.client:
    displayName: Client
  note.verified:
    displayName: Verified
views:
  - type: table
    name: By client
    groupBy:
      property: client
      direction: ASC
    order:
      - heater-tag
      - heater-type
      - service
      - facility
      - verified
  - type: table
    name: By type
    groupBy:
      property: heater-type
      direction: ASC
    order:
      - heater-tag
      - service
      - client
      - facility
      - verified
  - type: table
    name: Never verified
    filters:
      and:
        - note.verified == "never"
    groupBy:
      property: client
      direction: ASC
    order:
      - heater-tag
      - service
      - facility
      - source
  - type: table
    name: Verification log
    filters:
      and:
        - note.verified != "never"
    order:
      - verified
      - heater-tag
      - client
      - source
